<launch>
    <let name="use_sim" value="true" />
    <let name="gazebo_config_path" value="$(find-pkg-share sum2026_bringup)/config/gazebo_bridge.yaml" />
    <let name="world_path" value="$(find-pkg-share sum2026_bringup)/worlds/sum2026_world.sdf" />
    <let name="gz_args" value="$(var world_path) -r" />

    <include file="$(find-pkg-share sum2026_bringup)/launch/sum2026.launch.xml" />

    <node pkg="tf2_ros" exec="static_transform_publisher" args="--frame-id map --child-frame-id odom" />

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" />

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -x -4 -y -4" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>

    <node pkg="controller_manager" exec="spawner" args="joint_state_broadcaster" />
    <node pkg="controller_manager" exec="spawner" args="diff_drive_controller" />
</launch>
