<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="lidar_radius" value="0.05" />
    <xacro:property name="lidar_height" value="0.06" />
    <xacro:property name="lidar_mass" value="0.2" />
    <xacro:property name="lidar_xyz" value="0 0 ${base_height}" />
    <xacro:property name="lidar_samples" value="360" />
    <xacro:property name="lidar_update_rate" value="10" />
    <xacro:property name="lidar_range_min" value="0.12" />
    <xacro:property name="lidar_range_max" value="10.0" />
    <xacro:property name="lidar_range_resolution" value="0.01" />

    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0" />
            <material name="green" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${lidar_radius}" length="${lidar_height}" />
            </geometry>
            <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="${lidar_mass}" r="${lidar_radius}" l="${lidar_height}"
                                o_xyz="0 0 ${lidar_height / 2.0}" o_rpy="0 0 0" />
    </link>

    <joint name="base_lidar_joint" type="fixed">
        <parent link="base_link" />
        <child link="lidar_link" />
        <origin xyz="${lidar_xyz}" rpy="0 0 0" />
    </joint>

    <xacro:if value="$(arg use_sim)">
        <gazebo reference="lidar_link">
            <sensor name="lidar" type="gpu_lidar">
                <topic>scan</topic>
                <update_rate>${lidar_update_rate}</update_rate>
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>${lidar_samples}</samples>
                            <resolution>1</resolution>
                            <min_angle>-${pi}</min_angle>
                            <max_angle>${pi}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${lidar_range_min}</min>
                        <max>${lidar_range_max}</max>
                        <resolution>${lidar_range_resolution}</resolution>
                    </range>
                </lidar>
                <always_on>true</always_on>
                <visualize>true</visualize>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>
